{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/admin/:route*",
      "destination": "/api/admin/[...route]?route=:route*"
    },
    {
      "source": "/api/telegram/:route*",
      "destination": "/api/telegram/[...route]?route=:route*"
    },
    {
      "source": "/api/game/:route*",
      "destination": "/api/game/[...route]?route=:route*"
    },
    {
      "source": "/api/player/:route*",
      "destination": "/api/player/[...route]?route=:route*"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
