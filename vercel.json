{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/admin/:route*",
      "destination": "/api/admin?route=:route*"
    },
    {
      "source": "/api/telegram/:route*",
      "destination": "/api/telegram?route=:route*"
    },
    {
      "source": "/api/game/:route*",
      "destination": "/api/game?route=:route*"
    },
    {
      "source": "/api/player/:route*",
      "destination": "/api/player?route=:route*"
    },
    {
      "source": "/api/tts/:route*",
      "destination": "/api/game?route=tts/:route*"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
